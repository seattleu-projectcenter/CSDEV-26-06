@page "{id}"
@model ContosoCrafts.WebSite.Pages.Product.UpdateModel

@{
    ViewData["Title"] = "Update Fighter";
}

<h1 class="mb-4">Update Fighter</h1>

@if (Model.Product == null)
{
    <div class="alert alert-warning" role="alert">
        The requested fighter could not be found.
    </div>
}
else
{
    <form method="post" class="fighter-update-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Product.Id" />

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Product.Title"></label>
                <input asp-for="Product.Title" class="form-control" />
                <span asp-validation-for="Product.Title" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Product.Nickname"></label>
                <input asp-for="Product.Nickname" class="form-control" />
                <span asp-validation-for="Product.Nickname" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="Product.Record"></label>
                <input asp-for="Product.Record" class="form-control" />
                <span asp-validation-for="Product.Record" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Status"></label>
                <input asp-for="Product.Status" class="form-control" />
                <span asp-validation-for="Product.Status" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Hometown"></label>
                <input asp-for="Product.Hometown" class="form-control" />
                <span asp-validation-for="Product.Hometown" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="Product.Height"></label>
                <input asp-for="Product.Height" class="form-control" />
                <span asp-validation-for="Product.Height" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Weight"></label>
                <input asp-for="Product.Weight" class="form-control" />
                <span asp-validation-for="Product.Weight" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Reach"></label>
                <input asp-for="Product.Reach" class="form-control" />
                <span asp-validation-for="Product.Reach" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Product.Stance"></label>
                <input asp-for="Product.Stance" class="form-control" />
                <span asp-validation-for="Product.Stance" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Product.DateOfBirth"></label>
                <input asp-for="Product.DateOfBirth" class="form-control" />
                <span asp-validation-for="Product.DateOfBirth" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Product.Description"></label>
            <textarea asp-for="Product.Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Product.Description" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Product.Url"></label>
                <input asp-for="Product.Url" class="form-control" />
                <span asp-validation-for="Product.Url" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Product.Image"></label>
                <input asp-for="Product.Image" class="form-control" />
                <span asp-validation-for="Product.Image" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-page="./Index" asp-route-id="@Model.Product.Id" class="btn btn-secondary">Cancel</a>
            <button type="button" class="btn btn-primary"
                    data-toggle="modal" data-target="#confirmUpdateModal"
                    data-bs-toggle="modal" data-bs-target="#confirmUpdateModal">
                Save Changes
            </button>
        </div>
    </form>

    <div class="modal fade confirm-action-modal" id="confirmUpdateModal" tabindex="-1" role="dialog" aria-labelledby="confirmUpdateModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmUpdateModalLabel">Confirm Fighter Update</h5>
                    <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    Are you sure you want to save these changes?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
                    <button id="confirmUpdateButton" type="button" class="btn btn-primary">Confirm</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var confirmBtn = document.getElementById('confirmUpdateButton');
            if (!confirmBtn) {
                return;
            }

            confirmBtn.addEventListener('click', function () {
                var form = document.querySelector('form.fighter-update-form');
                if (!form) {
                    return;
                }

                if (window.jQuery && typeof $(form).valid === 'function') {
                    if (!$(form).valid()) {
                        return;
                    }
                }

                form.submit();
            });
        });
    </script>
}
