@page
@model ContosoCrafts.WebSite.Pages.Product.AddFighterModel
@{
    ViewData["Title"] = "Add Fighter";
}

<div class="container">
    <a asp-page="./Index" class="btn btn-outline-secondary mb-3">← Back to Rankings</a>

    <h1 class="mb-4">Add Fighter</h1>

    <form method="post" class="fighter-update-form">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Product.Title"></label>
                <input asp-for="Product.Title" class="form-control" />
                <span asp-validation-for="Product.Title" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Product.Nickname"></label>
                <input asp-for="Product.Nickname" class="form-control" required/>
                <span asp-validation-for="Product.Nickname" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="Product.Record"></label>
                <input asp-for="Product.Record" class="form-control" />
                <span asp-validation-for="Product.Record" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Status"></label>
                <input asp-for="Product.Status" class="form-control" required/>
                <span asp-validation-for="Product.Status" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Hometown"></label>
                <input asp-for="Product.Hometown" class="form-control" required/>
                <span asp-validation-for="Product.Hometown" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="Product.Height"></label>
                <input asp-for="Product.Height" class="form-control" required/>
                <span asp-validation-for="Product.Height" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Weight"></label>
                <input asp-for="Product.Weight" class="form-control" required/>
                <span asp-validation-for="Product.Weight" class="text-danger"></span>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Reach"></label>
                <input asp-for="Product.Reach" class="form-control" required/>
                <span asp-validation-for="Product.Reach" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Product.Stance"></label>
                <input asp-for="Product.Stance" class="form-control" required/>
                <span asp-validation-for="Product.Stance" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Product.DateOfBirth"></label>
                <input asp-for="Product.DateOfBirth" class="form-control" required/>
                <span asp-validation-for="Product.DateOfBirth" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Product.Description"></label>
            <textarea asp-for="Product.Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Product.Description" class="text-danger"></span>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Product.Url"></label>
                <input asp-for="Product.Url" class="form-control" />
                <span asp-validation-for="Product.Url" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Product.Image"></label>
                <input asp-for="Product.Image" class="form-control" />
                <span asp-validation-for="Product.Image" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
             <button type="button" class="btn btn-primary"
                    data-toggle="modal" data-target="#confirmAddModal"
                    data-bs-toggle="modal" data-bs-target="#confirmAddModal">
                Add Fighter
            </button>
        </div>
    </form>

    <div class="modal fade confirm-action-modal" id="confirmAddModal" tabindex="-1" role="dialog" aria-labelledby="confirmAddModalLabel" aria-hidden="true">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="confirmAddModalLabel">Confirm Add Fighter</h5>
            <button type="button" class="close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body">
              Are you sure you want to create this fighter?
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal" data-bs-dismiss="modal">Cancel</button>
            <button id="confirmAddButton" type="button" class="btn btn-primary">Confirm</button>
          </div>
        </div>
      </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    document.addEventListener('DOMContentLoaded', function(){
      var confirmBtn = document.getElementById('confirmAddButton');
      if (!confirmBtn) return;
      confirmBtn.addEventListener('click', function(){
        var form = document.querySelector('form.fighter-update-form');
        if (!form) return;
        // If jquery.validate is available, run client-side validation first
        if (window.jQuery && $(form).valid && typeof $(form).valid === 'function') {
          if (!$(form).valid()) {
            // keep modal open to show validation messages
            return;
          }
        }
        // submit the form (will trigger server-side validation)
        form.submit();
      });
    });
    </script>
}
