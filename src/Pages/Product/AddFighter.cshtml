@page
@model ContosoCrafts.WebSite.Pages.Product.AddFighterModel
@{
    ViewData["Title"] = "Add Fighter";
}

<div class="container">
    <a asp-page="./Index" class="btn btn-outline-secondary mb-3">← Back to Rankings</a>

    <h1 class="mb-4">Add Fighter</h1>

    <form method="post" class="fighter-update-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Product.Title"></label>
                <input asp-for="Product.Title" class="form-control" />
                <span asp-validation-for="Product.Title" class="text-danger"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Product.Nickname"></label>
                <input asp-for="Product.Nickname" class="form-control" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="Product.Record"></label>
                <input asp-for="Product.Record" class="form-control" />
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Status"></label>
                <input asp-for="Product.Status" class="form-control" />
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Hometown"></label>
                <input asp-for="Product.Hometown" class="form-control" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="Product.Height"></label>
                <input asp-for="Product.Height" class="form-control" />
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Weight"></label>
                <input asp-for="Product.Weight" class="form-control" />
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Product.Reach"></label>
                <input asp-for="Product.Reach" class="form-control" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Product.Stance"></label>
                <input asp-for="Product.Stance" class="form-control" />
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Product.DateOfBirth"></label>
                <input asp-for="Product.DateOfBirth" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Product.Description"></label>
            <textarea asp-for="Product.Description" class="form-control" rows="5"></textarea>
        </div>

        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Product.Url"></label>
                <input asp-for="Product.Url" class="form-control" />
            </div>
            <div class="form-group col-md-6">
                <label asp-for="Product.Image"></label>
                <input asp-for="Product.Image" class="form-control" />
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Add Fighter</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}