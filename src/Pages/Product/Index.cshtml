@page "{id?}"
@model ContosoCrafts.WebSite.Pages.Product.IndexModel
@using ContosoCrafts.WebSite.Models
@inject ContosoCrafts.WebSite.Services.JsonFileProductService ProductService
@{
    ViewData["Title"] = "Index page";

    var id = (string)RouteData.Values["id"];
    var products = ProductService.GetAllData();
    ProductModel selected = !string.IsNullOrWhiteSpace(id)
        ? products.FirstOrDefault(p => p.Id == id)
        : null;
}

<div class="container">
    @if (selected == null)
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in products)
                {
                    <tr>
                        <td>@product.Title</td>
                        <td>
                            <a asp-page="./Index" asp-route-id="@product.Id">Read</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <a asp-page="./Index" asp-route-id="" class="btn btn-outline-secondary mb-3">← Back to Rankings</a>

        <div class="row">
            <div class="col-md-4">
                <img src="@selected.Image" alt="@selected.Title" class="img-fluid rounded" />
            </div>
            <div class="col-md-8">
                <h2>
                    @selected.Title
                    @if (!string.IsNullOrWhiteSpace(selected.Nickname))
                    {
                        <small class="text-muted">(@selected.Nickname)</small>
                    }
                </h2>
                <p>@selected.Description</p>

                <ul class="list-unstyled">
                    <li><strong>Record:</strong> @selected.Record</li>
                    <li><strong>Status:</strong> @selected.Status</li>
                    <li><strong>Hometown:</strong> @selected.Hometown</li>
                    <li><strong>Height:</strong> @selected.Height</li>
                    <li><strong>Weight:</strong> @selected.Weight</li>
                    <li><strong>Reach:</strong> @selected.Reach</li>
                    <li><strong>Stance:</strong> @selected.Stance</li>
                    <li><strong>DOB:</strong> @selected.DateOfBirth</li>
                </ul>

                @if (!string.IsNullOrWhiteSpace(selected.Url))
                {
                    <a class="btn btn-primary" href="@selected.Url" target="_blank" rel="noopener">Official Profile</a>
                }
            </div>
        </div>
    }
    <div class="roster-action-buttons">
        <button id="add-fighter-button" class="btn-add-fighter" type="button" aria-label="Add fighter">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span>New Fighter</span>
        </button>
        <button id="update-fighter-button" class="btn-update-fighter" type="button" aria-label="Update fighter rating">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4 17.25V20h2.75L17.81 8.94l-2.75-2.75L4 17.25zm15.71-8.04a1.003 1.003 0 0 0 0-1.42l-2.5-2.5a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 2.75 2.75 1.99-1.99z" fill="currentColor"/>
            </svg>
            <span>Update Fighter</span>
        </button>
    </div>
</div>
