@using ContosoCrafts.WebSite.Models
@using ContosoCrafts.WebSite.Services
@using Microsoft.AspNetCore.Components.Web
@inject JsonFileProductService ProductService

<div class="card-columns fighter-grid">
    @foreach (var product in ProductService.GetAllData())
    {
        <div class="card fighter-card" data-toggle="modal" data-target="#productModal" @onclick="(e => SelectProduct(product.Id))">
            <div class="card-img" style="background-image: url('@product.Image');">
                <div class="fighter-card-overlay">
                    <span class="fighter-card-status">@product.Status</span>
                    <span class="fighter-card-name">@product.Title</span>
                    <span class="fighter-card-nickname">@product.Nickname</span>
                    <span class="fighter-card-record">@product.Record</span>
                </div>
            </div>
            <div class="card-body">
                <p class="fighter-card-summary">@product.Description</p>
            </div>
        </div>
    }
</div>

@if (selectedProduct != null)
{
    <div class="modal fade" id="productModal" tabindex="-1" role="dialog" aria-labelledby="productTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productTitle">@selectedProduct.Title</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="fighter-modal-hero">
                        <div class="fighter-modal-image" style="background-image: url('@selectedProduct.Image');"></div>
                        <div class="fighter-modal-details">
                            <p class="fighter-modal-description">@selectedProduct.Description</p>
                            <div class="fighter-stats">
                                <div class="fighter-stat">
                                    <span class="fighter-stat-label">Nickname</span>
                                    <span class="fighter-stat-value">@selectedProduct.Nickname</span>
                                </div>
                                <div class="fighter-stat">
                                    <span class="fighter-stat-label">Record</span>
                                    <span class="fighter-stat-value">@selectedProduct.Record</span>
                                </div>
                                <div class="fighter-stat">
                                    <span class="fighter-stat-label">Status</span>
                                    <span class="fighter-stat-value">@selectedProduct.Status</span>
                                </div>
                                <div class="fighter-stat">
                                    <span class="fighter-stat-label">Hometown</span>
                                    <span class="fighter-stat-value">@selectedProduct.Hometown</span>
                                </div>
                                <div class="fighter-stat">
                                    <span class="fighter-stat-label">Height</span>
                                    <span class="fighter-stat-value">@selectedProduct.Height</span>
                                </div>
                                <div class="fighter-stat">
                                    <span class="fighter-stat-label">Weight</span>
                                    <span class="fighter-stat-value">@selectedProduct.Weight</span>
                                </div>
                                <div class="fighter-stat">
                                    <span class="fighter-stat-label">Reach</span>
                                    <span class="fighter-stat-value">@selectedProduct.Reach</span>
                                </div>
                                <div class="fighter-stat">
                                    <span class="fighter-stat-label">Stance</span>
                                    <span class="fighter-stat-value">@selectedProduct.Stance</span>
                                </div>
                                <div class="fighter-stat">
                                    <span class="fighter-stat-label">DOB</span>
                                    <span class="fighter-stat-value">@selectedProduct.DateOfBirth</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer fighter-modal-footer">
                    <a class="btn btn-primary" href="@selectedProduct.Url" target="_blank" rel="noopener">
                        View full profile
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code
{
    ProductModel selectedProduct;
    string selectedProductId;

    void SelectProduct(string productId)
    {
        selectedProductId = productId;
        selectedProduct = ProductService.GetAllData().First(x => x.Id == productId);
    }
}
